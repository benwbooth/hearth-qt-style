# The Hearth Qt style as a Flatpak extension of org.kde.Platform//@BRANCH@
# (generated by flatpak/build.sh; @...@ are filled in there).
#
# Mounted at /usr/share/runtime/lib/plugins/Hearth; the runtime merges its
# styles/ into Qt's plugin path, so every app on the runtime can use the
# "Hearth" widget style. Qt 6 branches also carry the org.hearth.desktop
# Qt Quick Controls style (qml/) and its Kirigami platform plugin (kf6/),
# which build.sh puts on each app's paths with per-app overrides.
id: org.kde.KStyle.Hearth
branch: '@BRANCH@'
runtime: org.kde.Platform
runtime-version: '@BRANCH@'
sdk: org.kde.Sdk
build-extension: true
appstream-compose: false
separate-locales: false
build-options:
  prefix: /usr/share/runtime/lib/plugins/Hearth
modules:
  - name: hearth-qt-style
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DQT_MAJOR_VERSION=@QT@
      - -DBUILD_GALLERY=OFF
      - -DPLUGIN_INSTALL_DIR=styles
      - -DQML_INSTALL_DIR=qml
    sources:
      - type: dir
        path: @SRC@
        skip:
          - build5
          - build6
          - result
          - shots
          - .git
